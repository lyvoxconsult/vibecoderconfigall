# ==============================================================================
# TEMPLATE DE CONFIGURAÇÕES E VARIÁVEIS DE AMBIENTE - vibecoderconfigall
# ==============================================================================
# Copie este arquivo para ".env" e preencha as variáveis de forma local.
# O arquivo ".env" está listado no .gitignore e NUNCA será versionado no Git.

# ------------------------------------------------------------------------------
# 🧠 Inteligência Artificial & Provedores de Modelos (LLMs)
# ------------------------------------------------------------------------------
# Chaves essenciais para funcionamento do Antigravity, Codex e extensões de IA.
GEMINI_API_KEY=coloque_sua_gemini_api_key_aqui
OPENAI_API_KEY=coloque_sua_openai_api_key_aqui
ANTHROPIC_API_KEY=coloque_sua_anthropic_api_key_aqui

# ------------------------------------------------------------------------------
# 💻 Integração de Repositórios & Controle de Versão (GitHub CLI)
# ------------------------------------------------------------------------------
# Token de acesso pessoal (PAT) do GitHub para manipulação automática de PRs e Issues.
GITHUB_TOKEN=coloque_seu_github_personal_token_aqui
GITHUB_USER=seu_nome_usuario_github

# ------------------------------------------------------------------------------
# 🚀 Hospedagem & Deploy Contínuo (Vercel)
# ------------------------------------------------------------------------------
# Token de autenticação para automação de builds e deploys na Vercel via CLI.
VERCEL_TOKEN=coloque_seu_vercel_token_aqui
VERCEL_ORG_ID=coloque_seu_vercel_org_id_aqui
VERCEL_PROJECT_ID=coloque_seu_vercel_project_id_aqui

# ------------------------------------------------------------------------------
# 🗄️ Backend como Serviço (Supabase)
# ------------------------------------------------------------------------------
# Configurações de API e chaves de segurança para integração local ou cloud com Supabase.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=coloque_sua_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=coloque_sua_supabase_service_role_key_aqui
SUPABASE_DB_PASSWORD=coloque_a_senha_do_banco_de_dados_aqui

# ------------------------------------------------------------------------------
# ⚙️ Variáveis Operacionais do Sistema de Trabalho
# ------------------------------------------------------------------------------
# Diretórios locais e configurações de desenvolvimento recomendados.
PROJECTS_ROOT_PATH=
OBSIDIAN_VAULT_PATH=
ENVIRONMENT_MODE=development
DEBUG_MODE=false
PAGER=cat

# VPS Lyvox (sem credenciais)
TZ=America/Sao_Paulo
LYVOX_ROOT=/opt/lyvox
LYVOX_CORE_PATH=/opt/lyvox/docs/lyvox-core
LYVOX_SKILLS_PATH=/opt/lyvox/skills
GITHUB_REPO_URL=https://github.com/SEU_USUARIO/vibecoderconfigall.git

# n8n: use docker/n8n/.env local a partir do exemplo dedicado.
N8N_PORT=5678
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=
# Obrigatório no runtime. Gere: openssl rand -hex 32
N8N_ENCRYPTION_KEY=SUBSTITUA_POR_VALOR_FORTE_FORA_DO_GIT
