# ==============================================================================
# TEMPLATE DE VARIAVEIS LOCAIS - vibecoderconfigall
# ==============================================================================
# Copie para ".env" no Mac e preencha localmente.
# O arquivo ".env" esta no .gitignore e nunca deve ser versionado.

# IA e provedores
GEMINI_API_KEY=coloque_sua_gemini_api_key_aqui
OPENAI_API_KEY=coloque_sua_openai_api_key_aqui
ANTHROPIC_API_KEY=coloque_sua_anthropic_api_key_aqui

# GitHub
GITHUB_TOKEN=coloque_seu_github_personal_token_aqui
GITHUB_USER=seu_nome_usuario_github

# Vercel
VERCEL_TOKEN=coloque_seu_vercel_token_aqui
VERCEL_ORG_ID=coloque_seu_vercel_org_id_aqui
VERCEL_PROJECT_ID=coloque_seu_vercel_project_id_aqui

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=coloque_sua_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=coloque_sua_supabase_service_role_key_aqui
SUPABASE_DB_PASSWORD=coloque_a_senha_do_banco_de_dados_aqui

# Caminhos locais no Mac
PROJECTS_ROOT_PATH=
OBSIDIAN_VAULT_PATH=
CODEX_CONFIG_PATH=
ANTIGRAVITY_CONFIG_PATH=
LOCAL_SKILLS_PATH=

# Operacao
ENVIRONMENT_MODE=development
DEBUG_MODE=false
PAGER=cat
TZ=America/Sao_Paulo
GITHUB_REPO_URL=https://github.com/SEU_USUARIO/vibecoderconfigall.git
